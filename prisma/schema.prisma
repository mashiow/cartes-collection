generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Rarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  coins Int @default(0)

  sessions     Session[]
  accounts     Account[]
  cards        UserCard[]
  transactions CoinTransaction[]

  tradesCreated  Trade[] @relation("TradeCreator")
  tradesAccepted Trade[] @relation("TradeAccepter")
  
  lastDailyDate  String?
  lastWeeklyDate String?
  freeBoosters   Int     @default(0)

  gamesDate   String?
  gamesPlayed Int     @default(0)

    isAdmin             Boolean @default(false)
  hideFromLeaderboard Boolean @default(false)
}

model Session {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Card {
  id       String @id @default(cuid())
  name     String
  bio      String @default("")
  imageUrl String
  rarity   Rarity
  series   String

  owners UserCard[]

  tradesOffered Trade[] @relation("TradeOffered")
  tradesWanted  Trade[] @relation("TradeWanted")
}

model UserCard {
  id       String @id @default(cuid())
  userId   String
  cardId   String
  quantity Int    @default(1)

  user User @relation(fields: [userId], references: [id])
  card Card @relation(fields: [cardId], references: [id])
  

  @@unique([userId, cardId])
}

model CoinTransaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model CoinDrop {
  id          String    @id @default(cuid())
  messageId   String    @unique
  channelId   String
  amount      Int
  createdBy   String?
  claimedById String?
  claimedAt   DateTime?
  createdAt   DateTime  @default(now())
}

enum TradeStatus {
  OPEN
  COMPLETED
  CANCELLED
}

model Trade {
  id            String      @id @default(cuid())
  creatorId     String
  offeredCardId String
  wantedCardId  String
  status        TradeStatus @default(OPEN)
  acceptedById  String?
  createdAt     DateTime    @default(now())
  completedAt   DateTime?

  creator     User  @relation("TradeCreator", fields: [creatorId], references: [id])
  acceptedBy  User? @relation("TradeAccepter", fields: [acceptedById], references: [id])
  offeredCard Card  @relation("TradeOffered", fields: [offeredCardId], references: [id])
  wantedCard  Card  @relation("TradeWanted", fields: [wantedCardId], references: [id])

  @@index([status])
}

model News {
  id        String   @id @default(cuid())
  title     String
  body      String
  createdAt DateTime @default(now())
}
model QuizRound {
  id         String    @id @default(cuid())
  userId     String
  cardId     String
  optionIds  String[]
  chosenId   String?
  answeredAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, answeredAt])
}

model ScratchTicket {
  id            String    @id @default(cuid())
  userId        String
  day           String
  prizeCoins    Int       @default(0)
  prizeBoosters Int       @default(0)
  claimedAt     DateTime?
  createdAt     DateTime  @default(now())

  @@unique([userId, day])
  @@index([userId, claimedAt])
}